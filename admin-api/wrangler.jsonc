{
  "name": "pandora-saga-simulator-remaked-admin-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "vars": {
    "PUBLIC_ORIGIN": "https://bonaqu.github.io",
    "ADMIN_ORIGIN": "https://pandora-saga-simulator-remaked-admin-api.bonaqu.workers.dev"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pandora-saga-simulator-remaked-admin-db",
    "database_id": "a786d50a-56e1-4868-8ca5-58cd1b248d85",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
